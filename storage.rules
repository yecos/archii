rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for carnet template images (backgrounds, logos, elements)
    // These are referenced by public URL in Firestore documents
    match /tenants/{tenantId}/carnet-templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.members;
    }

    // All other tenant files are private to tenant members.
    // Public assets must live under the explicit carnet-templates path above.
    match /tenants/{tenantId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid in firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.members;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
